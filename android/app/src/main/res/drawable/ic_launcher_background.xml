<!--
  The launcher tile: packaging/io.narl.proton-stream.svg's face gradient, on
  the full 108dp canvas because the launcher cuts its own shape out of it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108">
                <item android:offset="0" android:color="#FFA48BFF" />
                <item android:offset="0.55" android:color="#FF7552FF" />
                <item android:offset="1" android:color="#FF5B36F2" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
